rules_version = '2';

// Assumed order model: orders/{id} is created by trusted Cloud Functions with
// immutable buyer userId, ticketCode, items and totals. delivered / paid are
// booleans; their UpdatedAt (timestamp), UpdatedByUid and UpdatedByName are
// written only by atomic staff callables. Admin clients retain deletion access.
// orders/{id}/history/{eventId} records action, previousValue/value (bool),
// actorUid/name, occurredAt (timestamp), and optional codeVerification /
// overrideReason. Trusted functions append it atomically with status changes;
// clients cannot create, update or delete audit records. Staff may read retained
// history after an order is deleted. Existing public content and staff flows
// outside orders keep their established access rules.

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helpers
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function pendingPath(email) {
      return /databases/$(database)/documents/pendingUsers/$(email);
    }

    // manager = 1, admin = 2, super_admin (舞會總副召) = 3, developer = 4,
    // anyone else = 0. Developers can do everything super admins can.
    function roleRank() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? { 'manager': 1, 'admin': 2, 'super_admin': 3, 'developer': 4 }
            .get(get(userPath(request.auth.uid)).data.get('role', ''), 0)
        : 0;
    }

    function isManager() {
      return roleRank() >= 1;
    }

    function isAdmin() {
      return roleRank() >= 2;
    }

    function isSuperAdmin() {
      return roleRank() >= 3;
    }

    function isDeveloper() {
      return roleRank() >= 4;
    }

    function isStaffRole(role) {
      return role in ['manager', 'admin', 'super_admin', 'developer'];
    }

    // Super admins manage staff accounts and invites, but only developers
    // may grant the developer role or touch an account or invite that has
    // it, so a super admin can never remove or demote a developer. Staff
    // accounts are created only by their own activation (below), so a super
    // admin cannot pre-empt a developer's invite by creating the invitee's
    // account first.
    function canGrantRole(role) {
      return isSuperAdmin() && isStaffRole(role) && (role != 'developer' || isDeveloper());
    }

    function canManageExisting() {
      return isSuperAdmin()
        && (resource == null || resource.data.get('role', '') != 'developer' || isDeveloper());
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isShortString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    // =========================
    // Staff accounts
    // =========================

    // Everyone signs in with Google; only staff have a users/{uid} document.

    match /users/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
      allow list: if isSuperAdmin();

      // An invited staff member activates their own account on first login,
      // the only way a client creates one: super admins invite through
      // pendingUsers. The role must be exactly the one in their invite, and
      // the invite must be deleted in the same batch so it can never be used
      // twice.
      allow create: if (
        signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && exists(pendingPath(signedInEmail()))
        && !existsAfter(pendingPath(signedInEmail()))
        && request.resource.data.role == get(pendingPath(signedInEmail())).data.role
        && request.resource.data.get('name', '') == get(pendingPath(signedInEmail())).data.get('name', '')
        && request.resource.data.email == signedInEmail()
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'name', 'role', 'uid', 'createdAt', 'updatedAt'
        ])
      );

      // Staff may refresh their own profile, never their role. Nobody
      // changes their own role or deletes their own account, so whoever
      // removes a developer is another developer who stays: there is always
      // at least one.
      allow update: if (
        canManageExisting()
        && canGrantRole(request.resource.data.role)
        && (userId != request.auth.uid || request.resource.data.role == resource.data.get('role', ''))
      ) || (
        signedIn()
        && request.auth.uid == userId
        && onlyChanges(['email', 'displayName', 'photoURL', 'updatedAt'])
      );

      allow delete: if canManageExisting() && userId != request.auth.uid;
    }

    // Invites, keyed by lower-case email. Only super admins can list them;
    // an invitee can read nothing but their own invite.
    match /pendingUsers/{email} {
      allow get: if isSuperAdmin() || (
        signedIn()
        && request.auth.token.email_verified == true
        && signedInEmail() == email
      );
      allow list: if isSuperAdmin();

      allow create, update: if canManageExisting()
        && canGrantRole(request.resource.data.role)
        && email == email.lower()
        && request.resource.data.email == email;

      // the invitee may only consume their own invite while activating
      allow delete: if canManageExisting() || (
        signedIn()
        && signedInEmail() == email
        && !exists(userPath(request.auth.uid))
        && existsAfter(userPath(request.auth.uid))
      );
    }

    // =========================
    // Orders
    // =========================

    // Created only by Cloud Functions (Admin SDK bypasses rules): createOrder
    // sets userId to the signed-in buyer. A buyer can read only their own
    // orders: lists must filter on where('userId', '==', uid), and an order
    // id that does not exist or is someone else's is denied.
    function isOrderOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    // 公關票 an officer still on the list sent (functions/lib/guests.js);
    // their lists must filter on officerEmail
    function isOrderOfficer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && resource.data.get('officerEmail', null) == signedInEmail()
        && isOfficer();
    }

    match /orders/{orderId} {
      // Managers (door staff) open single orders from ticket QR codes; only
      // admins may list every buyer's details.
      allow get: if isManager() || isOrderOwner() || isOrderOfficer();
      allow list: if isAdmin() || isOrderOwner() || isOrderOfficer();
      allow create: if false;

      // Status transitions and attribution require the atomic callables. Even
      // administrators cannot bypass their stale-state / QR checks directly.
      allow update: if false;

      allow delete: if isAdmin();

      match /history/{eventId} {
        allow read: if isManager();
        allow create, update, delete: if false;
      }
    }

    // Buyers never update or delete orders. ticketSales, buyerPurchases,
    // orderRequests, rateLimits, stockReleases, notificationJobs,
    // sellerReleases, invitationRequests, officerReleases and
    // streetSaleRequests are only touched by Cloud Functions and fall
    // through to the deny-all rule below.

    // =========================
    // 清除所有訂單 (functions/lib/orderPurge.js)
    // =========================

    // Written only by purgeOrders. Super admins read the yearly summaries and
    // archived orders (/super_admin/analytics), a purge's progress, and the
    // log of who purged. Nobody can write them, so an archive cannot be
    // altered or a purge hidden from the log.
    match /salesArchives/{year} {
      allow read: if isSuperAdmin();

      match /archivedOrders/{orderId} {
        allow read: if isSuperAdmin();
      }

      // sale rows without the buyers' details (functions/lib/salesArchive.js),
      // also written by importSalesArchive
      match /rows/{chunk} {
        allow read: if isSuperAdmin();
      }
    }

    match /orderPurges/{purgeId} {
      allow read: if isSuperAdmin();
    }

    match /systemLogs/{logId} {
      allow read: if isSuperAdmin();
    }

    // =========================
    // Ticket types & public content
    // =========================

    // Every settings document is public. Writes are granted only by the
    // per-document matches below, so a new settings document stays read-only
    // until it gets its own rule.
    match /settings/{settingId} {
      allow read: if true;
    }

    // Ticket configuration (src/services/ticketTypeService.js), also read by
    // createOrder
    match /settings/ticketTypes {
      allow write: if isSuperAdmin();
    }

    // Site opening time (src/services/shopService.js), also checked by
    // createOrder. openAt is a timestamp, so it can never be an unparsable
    // value that silently puts the site back on the built-in default.
    // Deleting the document also falls back to the default.
    match /settings/shop {
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['openAt', 'updatedAt', 'updatedByUid'])
        && request.resource.data.openAt is timestamp
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // Scheduled content: the public can only read what is already published
    // (and, for stories, enabled). Queries must filter the same way
    // (src/services/contentService.js). 5 minutes of slack lets clients whose
    // clock runs slightly ahead still query.
    // (No `is timestamp` check: the rules engine cannot prove it from a query,
    // and a legacy string publishAt fails the comparison anyway, so it stays
    // hidden until the admin page migrates it.)
    function isPublishedNow() {
      return resource.data.publishAt <= request.time + duration.value(5, 'm');
    }

    match /partyStories/{storyId} {
      allow read: if isSuperAdmin() || (resource.data.enabled == true && isPublishedNow());
      allow write: if isSuperAdmin();
    }

    match /partyLineup/{itemId} {
      allow read: if isSuperAdmin() || isPublishedNow();
      allow write: if isSuperAdmin();
    }

    // =========================
    // 學弟登記賣票 (functions/lib/sellers.js)
    // =========================

    function sellerPath(email) {
      return /databases/$(database)/documents/sellers/$(email);
    }

    // on the seller list kept by super admins, signed in with that email
    function isSeller() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(sellerPath(signedInEmail()));
    }

    // Which ticket type sellers take from and the shared goal; public like
    // every settings document, also read by registerSellerTickets.
    match /settings/sellerProgram {
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'ticketTypeId', 'goal', 'updatedAt', 'updatedByUid'])
        && request.resource.data.enabled is bool
        && isShortString(request.resource.data.ticketTypeId, 100)
        && request.resource.data.goal is int
        && request.resource.data.goal >= 0
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // The seller list, keyed by lower-case email. A seller can read only
    // their own entry (to see the registration page).
    match /sellers/{email} {
      allow get: if isAdmin() || (
        signedIn()
        && request.auth.token.email_verified == true
        && signedInEmail() == email
      );
      allow list: if isAdmin();

      allow create, update: if isSuperAdmin()
        && email == email.lower()
        && request.resource.data.email == email
        && request.resource.data.keys().hasOnly(['email', 'name', 'createdAt'])
        && isShortString(request.resource.data.get('name', ''), 50);
      allow delete: if isSuperAdmin();
    }

    // Created only by registerSellerTickets, which takes the tickets from
    // stock. Sellers read their own (lists must filter on sellerUid); admins
    // record ticket pickup and payment, and may delete a mistaken one
    // (releaseSellerStock gives the tickets back).
    match /sellerRegistrations/{registrationId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.sellerUid == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin()
        && onlyChanges(['delivered', 'paid', 'updatedAt', 'updatedByUid'])
        && request.resource.data.delivered is bool
        && request.resource.data.paid is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // Tickets registered by everyone, for the goal progress
    match /sellerStats/summary {
      allow get: if isAdmin() || isSeller();
    }

    // =========================
    // 公關票 (functions/lib/guests.js)
    // =========================

    // The tickets themselves are orders with complimentary: true, created
    // only by the guests.js callables; their invitationRequests and
    // officerReleases markers fall through to the deny-all rule below.

    function officerPath(email) {
      return /databases/$(database)/documents/officers/$(email);
    }

    // on the officer list kept by super admins, signed in with that email
    function isOfficer() {
      return signedIn()
        && request.auth.token.email_verified == true
        && exists(officerPath(signedInEmail()));
    }

    // Keep 500 in sync with MAX_OFFICER_QUOTA in src/data/guests.js
    function isValidQuota(quota) {
      return quota is int && quota >= 0 && quota <= 500;
    }

    function isValidOfficerName(name) {
      return isShortString(name, 50) && name.trim().size() >= 1;
    }

    // The officer list, keyed by lower-case email: super admins set each
    // one's name and quota; `used` (tickets sent plus those held by open
    // invite links) is kept by the functions, and a quota cannot go below
    // it. An officer reads only their own entry.
    match /officers/{email} {
      allow get: if isSuperAdmin() || (
        signedIn()
        && request.auth.token.email_verified == true
        && signedInEmail() == email
      );
      allow list: if isSuperAdmin();

      allow create: if isSuperAdmin()
        && email == email.lower()
        && request.resource.data.keys().hasOnly(['email', 'name', 'quota', 'used', 'createdAt'])
        && request.resource.data.email == email
        && isValidOfficerName(request.resource.data.name)
        && isValidQuota(request.resource.data.quota)
        && request.resource.data.used == 0
        && request.resource.data.createdAt == request.time;

      allow update: if isSuperAdmin()
        && onlyChanges(['name', 'quota'])
        && isValidOfficerName(request.resource.data.name)
        && isValidQuota(request.resource.data.quota)
        && request.resource.data.quota >= resource.data.get('used', 0);

      // the tickets they sent stay valid; their open links stop working
      allow delete: if isSuperAdmin();
    }

    // Invite links, written only by the functions. The random id is the
    // secret in the link, so any signed-in account holding it may read it
    // (to see what it is before claiming); officers list their own (lists
    // must filter on officerEmail), super admins all of them, including
    // their own council links (no officer).
    match /officerInvites/{inviteId} {
      allow get: if signedIn();
      allow list: if isSuperAdmin() || (
        isOfficer() && resource.data.officerEmail == signedInEmail()
      );
    }

    // What a link is for, written only by createOfficerInvite (at most 100
    // characters, MAX_INVITE_NOTE in src/data/guests.js). Kept apart from
    // the link, which its guest reads: only its officer and super admins.
    match /officerInviteNotes/{inviteId} {
      allow get, list: if isSuperAdmin() || (
        isOfficer() && resource.data.officerEmail == signedInEmail()
      );
    }

    // 登記連結, made only by createGuestSignupLink. The random id is the
    // secret in the link, so any signed-in account holding it reads it (its
    // title and tickets per person); super admins list them and close or
    // reopen them.
    match /guestSignupLinks/{linkId} {
      allow get: if signedIn();
      allow list: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && onlyChanges(['open'])
        && request.resource.data.open is bool;

      // Each account's sign-up, keyed by its uid: created and changed (while
      // pending) only by submitGuestSignup, marked sent only by
      // sendGuestSignupTicket. The guest reads their own by its path, so
      // also before signing up. Super admins list a link's sign-ups and
      // review them (pending, approved or rejected), never once sent. A
      // review names the updatedAt of the sign-up it was made on, which
      // only submitGuestSignup changes, so one its guest changed after the
      // super admin's page loaded is refused rather than approved unseen.
      match /signups/{uid} {
        allow get: if isSuperAdmin() || (signedIn() && request.auth.uid == uid);
        allow list: if isSuperAdmin();
        allow update: if isSuperAdmin()
          && onlyChanges(['status', 'reviewedAt', 'reviewedByUid', 'reviewedUpdatedAt'])
          && resource.data.status in ['pending', 'approved', 'rejected']
          && request.resource.data.status in ['pending', 'approved', 'rejected']
          && request.resource.data.reviewedAt == request.time
          && request.resource.data.reviewedByUid == request.auth.uid
          && request.resource.data.reviewedUpdatedAt == resource.data.updatedAt;
        // junk, once rejected; its guest may sign up again while the link
        // is open. A sent one stays with its order.
        allow delete: if isSuperAdmin() && resource.data.status == 'rejected';
      }
    }

    // =========================
    // 路宣登記 (functions/lib/streetSales.js)
    // =========================

    // The sales themselves are paid, collected orders with streetSale: true
    // that admins register through registerStreetSale (admins list orders
    // already); its streetSaleRequests markers fall through to the deny-all
    // rule below.

    // Whether admins may register sales and of which ticket type; public
    // like every settings document, also read by registerStreetSale.
    match /settings/streetSale {
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['enabled', 'ticketTypeId', 'updatedAt', 'updatedByUid'])
        && request.resource.data.enabled is bool
        && isShortString(request.resource.data.ticketTypeId, 100)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if isSuperAdmin();
    }

    // =========================
    // 報帳 (functions/lib/reimbursements.js)
    // =========================

    // Admins claim back what they spent on the party; super admins approve,
    // pay out or reject the claims and count the approved ones against the
    // takings (/super_admin/reimbursements). Claims are created only by
    // submitReimbursement, which first puts the invoices in the council's
    // Google Drive, so every claim has them; its reimbursementFolders fall
    // through to the deny-all rule below.
    match /reimbursements/{reimbursementId} {
      // admins read their own (lists must filter on submitterUid)
      allow get, list: if isSuperAdmin() || (
        isAdmin() && resource.data.submitterUid == request.auth.uid
      );

      allow create: if false;

      // Reviewing changes the status alone, signed by whoever reviewed it;
      // super admins may also correct the 科目 the claimant picked (the
      // page offers REIMBURSEMENT_CATEGORIES in src/data/reimbursements.js).
      // The claim and its invoices stay as they were sent.
      allow update: if isSuperAdmin() && ((
        onlyChanges(['status', 'reviewedAt', 'reviewedByUid', 'reviewedByName'])
        && request.resource.data.status in ['pending', 'approved', 'paid', 'rejected']
        && request.resource.data.reviewedAt == request.time
        && request.resource.data.reviewedByUid == request.auth.uid
        && isShortString(request.resource.data.reviewedByName, 100)
      ) || (
        onlyChanges(['category'])
        && isShortString(request.resource.data.category, 20)
        && request.resource.data.category.size() >= 1
      ));

      // the submitter withdraws a claim only while it is pending;
      // trashReimbursementInvoices then trashes its invoices
      allow delete: if isSuperAdmin() || (
        isAdmin()
        && resource.data.submitterUid == request.auth.uid
        && resource.data.status == 'pending'
      );
    }

    // =========================
    // Survey
    // =========================

    // Anyone may answer without signing in, so answers go through
    // submitSurvey (functions), which checks them and a Turnstile token
    // before writing here; no client writes.
    match /surveyResponses/{responseId} {
      allow create: if false;

      allow read: if isManager();
      allow delete: if isSuperAdmin();
      allow update: if false;
    }

    // =========================
    // 舞會滿意度調查
    // =========================

    // One document per party year (src/services/partySurveyService.js): its
    // questions and whether it takes answers. Public, so the survey page can
    // show them; super admins edit both on /admin/party-survey, and a survey opens
    // only with questions. Questions change from year to year, so answers are
    // checked against them by submitPartySurvey (functions), which writes
    // partySurveys/{year}/responses; no client writes there.
    match /partySurveys/{year} {
      allow read: if true;
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['year', 'open', 'sections', 'updatedAt', 'updatedByUid'])
        && request.resource.data.year == int(year)
        && request.resource.data.open is bool
        && request.resource.data.get('sections', []) is list
        // keep in sync with LIMITS in src/data/partySurveyQuestions.js
        && request.resource.data.get('sections', []).size() <= 20
        && (request.resource.data.open == false || request.resource.data.get('sections', []).size() > 0)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedByUid == request.auth.uid;
      allow delete: if false;

      match /responses/{responseId} {
        allow read, delete: if isSuperAdmin();
      }
    }

    // =========================
    // 手機掃描、電腦處理 (src/services/scanLinkService.js)
    // =========================

    // A computer at the check-in desk (/admin/scan/desk) makes a link and
    // shows its id as a pairing QR code. A phone that scans it on
    // /admin/scan writes each ticket it reads here instead of opening it;
    // the computer listens and opens the order, where tickets are collected
    // with the usual callables (so the ticketCode check still applies). The
    // id is a random Firestore id, only ever shown in that QR code, so links
    // are read by id and never listed. Links take scans for 12 hours
    // (SCAN_LINK_HOURS in src/utils/scanLink.js).
    function isValidScanLinkPhone(phone) {
      return phone is map
        && phone.keys().hasAll(['uid', 'name', 'at'])
        && phone.keys().hasOnly(['uid', 'name', 'at'])
        && phone.uid == request.auth.uid
        && isShortString(phone.name, 200)
        && phone.at == request.time;
    }

    function isValidScanLinkScan(scan) {
      return scan is map
        && scan.keys().hasAll(['id', 'orderId', 'ticketCode', 'at', 'byUid'])
        && scan.keys().hasOnly(['id', 'orderId', 'ticketCode', 'at', 'byUid'])
        && isShortString(scan.id, 64)
        && scan.id.size() > 0
        // ORDER_ID_PATTERN in src/utils/ticketQr.js
        && scan.orderId is string
        && scan.orderId.matches('[A-Z]{1,4}[0-9]{8}([0-9]{4}|[A-HJ-NP-Z2-9]{6})')
        && isShortString(scan.ticketCode, 200)
        && scan.at == request.time
        && scan.byUid == request.auth.uid;
    }

    match /scanLinks/{linkId} {
      allow get: if isManager();
      allow list: if false;

      allow create: if isManager()
        && request.resource.data.keys().hasAll(['ownerUid', 'ownerName', 'createdAt'])
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && isShortString(request.resource.data.ownerName, 200)
        && request.resource.data.createdAt == request.time;

      // phones: every write says which phone it is; a scan comes with one
      allow update: if isManager()
        && request.time < resource.data.createdAt + duration.value(12, 'h')
        && onlyChanges(['phone', 'scan'])
        && isValidScanLinkPhone(request.resource.data.phone)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['scan'])
          || isValidScanLinkScan(request.resource.data.scan));

      // the computer ends its own link; super admins clear old ones
      allow delete: if (isManager() && resource.data.ownerUid == request.auth.uid)
        || isSuperAdmin();
    }

    // =========================
    // Everything else is denied
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
