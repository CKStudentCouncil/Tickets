rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // 基本權限
    // =========================

    function isAuthenticated() {
      return request.auth != null;
    }

    function userDoc() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      );
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        );
    }

    function isSuperAdmin() {
      return hasUserDoc() &&
        userDoc().data.role == "super_admin";
    }

    function isAdmin() {
      return hasUserDoc() &&
        (
          userDoc().data.role == "admin" ||
          userDoc().data.role == "super_admin"
        );
    }

    function isManager() {
      return hasUserDoc() &&
        (
          userDoc().data.role == "manager" ||
          userDoc().data.role == "admin" ||
          userDoc().data.role == "super_admin"
        );
    }

    function isOwner(userId) {
      return isAuthenticated() &&
        request.auth.uid == userId;
    }

    // =========================
    // 購物車
    // =========================

    match /carts/{userId} {

      allow read, write:
        if isOwner(userId) || isAdmin();

      allow delete:
        if isOwner(userId) || isAdmin();
    }

    // =========================
    // 訂單
    // =========================

    match /orders/{orderId} {

      allow create, read:
        if true;

      allow update:
        if isManager();

      allow delete:
        if isAdmin();
    }

    // =========================
    // 使用者
    // =========================

    match /users/{userId} {

      allow get:
        if request.auth != null;

      allow list:
        if isSuperAdmin();

      allow create:
        if request.auth != null;

      allow update:
        if request.auth.uid == userId
        ||
        isSuperAdmin();

      allow delete:
        if isSuperAdmin();
    }
    
    // =========================
    // 問卷回覆
    // =========================
    match /surveyResponses/{responseId} {
      allow create:
        if true;
      allow read:
        if isManager();
      allow update:
        if false;
      allow delete:
        if isManager();
    }

    // =========================
    // 系統設定（票種等）
    // =========================
    match /settings/{settingId} {
      allow read:
        if true;
      allow write:
        if isAdmin();
    }

    // =========================
    // 其他全部拒絕
    // =========================

    match /pendingUsers/{pendingId} {

      allow read:
        if request.auth != null;

      allow create:
        if isSuperAdmin();

      allow update:
        if isSuperAdmin();

      allow delete:
        if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}