rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================
    // Helpers
    // =========================

    function signedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function pendingPath(email) {
      return /databases/$(database)/documents/pendingUsers/$(email);
    }

    // manager = 1, admin = 2, super_admin = 3, anyone else = 0
    function roleRank() {
      return signedIn() && exists(userPath(request.auth.uid))
        ? { 'manager': 1, 'admin': 2, 'super_admin': 3 }
            .get(get(userPath(request.auth.uid)).data.get('role', ''), 0)
        : 0;
    }

    function isManager() {
      return roleRank() >= 1;
    }

    function isAdmin() {
      return roleRank() >= 2;
    }

    function isSuperAdmin() {
      return roleRank() >= 3;
    }

    function isStaffRole(role) {
      return role in ['manager', 'admin', 'super_admin'];
    }

    function signedInEmail() {
      return request.auth.token.email.lower();
    }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function isShortString(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }

    // =========================
    // Staff accounts
    // =========================

    match /users/{userId} {
      allow get: if (signedIn() && request.auth.uid == userId) || isSuperAdmin();
      allow list: if isSuperAdmin();

      // An invited staff member activates their own account on first login.
      // The role must be exactly the one in their invite, and the invite must
      // be deleted in the same batch so it can never be used twice.
      allow create: if (isSuperAdmin() && isStaffRole(request.resource.data.role)) || (
        signedIn()
        && request.auth.uid == userId
        && request.auth.token.email_verified == true
        && exists(pendingPath(signedInEmail()))
        && !existsAfter(pendingPath(signedInEmail()))
        && request.resource.data.role == get(pendingPath(signedInEmail())).data.role
        && request.resource.data.get('name', '') == get(pendingPath(signedInEmail())).data.get('name', '')
        && request.resource.data.email == signedInEmail()
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly([
          'email', 'displayName', 'photoURL', 'name', 'role', 'uid', 'createdAt', 'updatedAt'
        ])
      );

      // Staff may refresh their own profile, never their role.
      allow update: if (isSuperAdmin() && isStaffRole(request.resource.data.role)) || (
        signedIn()
        && request.auth.uid == userId
        && onlyChanges(['email', 'displayName', 'photoURL', 'updatedAt'])
      );

      allow delete: if isSuperAdmin();
    }

    // Invites, keyed by lower-case email. Only super admins can list them;
    // an invitee can read nothing but their own invite.
    match /pendingUsers/{email} {
      allow get: if isSuperAdmin() || (
        signedIn()
        && request.auth.token.email_verified == true
        && signedInEmail() == email
      );
      allow list: if isSuperAdmin();

      allow create, update: if isSuperAdmin()
        && email == email.lower()
        && request.resource.data.email == email
        && isStaffRole(request.resource.data.role);

      // the invitee may only consume their own invite while activating
      allow delete: if isSuperAdmin() || (
        signedIn()
        && signedInEmail() == email
        && !exists(userPath(request.auth.uid))
        && existsAfter(userPath(request.auth.uid))
      );
    }

    // =========================
    // Orders
    // =========================

    // Created only by the createOrder Cloud Function (Admin SDK bypasses
    // rules). Buyers read their own orders through the getOrders function.
    match /orders/{orderId} {
      allow read: if isManager();
      allow create: if false;

      allow update: if (
        isManager()
        && onlyChanges(['delivered', 'deliveryUpdatedAt', 'deliveryUpdatedByName'])
        && request.resource.data.delivered is bool
      ) || (
        isAdmin()
        && onlyChanges([
          'delivered', 'deliveryUpdatedAt', 'deliveryUpdatedByName',
          'paid', 'paymentUpdatedAt', 'paymentUpdatedByName'
        ])
        && request.resource.data.get('delivered', false) is bool
        && request.resource.data.get('paid', false) is bool
      );

      allow delete: if isAdmin();
    }

    // orderCounters, ticketSales, buyerPurchases and stockReleases are only
    // touched by Cloud Functions and fall through to the deny-all rule below.

    // =========================
    // Ticket types & public content
    // =========================

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Scheduled content: the public can only read what is already published
    // (and, for stories, enabled). Queries must filter the same way
    // (src/services/contentService.js). 5 minutes of slack lets clients whose
    // clock runs slightly ahead still query.
    // (No `is timestamp` check: the rules engine cannot prove it from a query,
    // and a legacy string publishAt fails the comparison anyway, so it stays
    // hidden until the admin page migrates it.)
    function isPublishedNow() {
      return resource.data.publishAt <= request.time + duration.value(5, 'm');
    }

    match /partyStories/{storyId} {
      allow read: if isSuperAdmin() || (resource.data.enabled == true && isPublishedNow());
      allow write: if isSuperAdmin();
    }

    match /partyLineup/{itemId} {
      allow read: if isSuperAdmin() || isPublishedNow();
      allow write: if isSuperAdmin();
    }

    // =========================
    // Survey
    // =========================

    // Keep these lists in sync with src/data/surveyQuestions.js
    // (tests/firestore.rules.test.js submits every option to check).
    function identityOptions() {
      return [
        '建國中學學生',
        '建國中學家長',
        '建國中學教師',
        '北一女中學生',
        '中山女高學生',
        '景美女中學生',
        '成功高中學生',
        '師大附中學生',
        '其他學校學生',
        '社會人士',
        '其他'
      ];
    }

    function channelOptions() {
      return [
        '班聯會官方 Instagram',
        'CK APP',
        '班代或班級轉知',
        '同學或朋友分享',
        '建中相關社群',
        '搜尋引擎',
        '其他'
      ];
    }

    function deviceOptions() {
      return [
        '手機',
        '平板',
        '筆記型電腦',
        '桌上型電腦',
        '其他'
      ];
    }

    function issueCountOptions() {
      return [
        '沒有遇到問題',
        '遇到過一次',
        '遇到過 2～3 次',
        '遇到過 4 次以上'
      ];
    }

    function issueTypeOptions() {
      return [
        '找不到購票入口',
        '票種資訊不清楚',
        '活動資訊不清楚',
        '購票資格確認',
        '選擇票種',
        '填寫購票資料',
        '付款或付款資訊',
        '訂單送出',
        '訂單確認',
        '電子票券或入場資訊',
        '網頁載入速度',
        '手機版介面',
        '登入或帳號',
        '其他'
      ];
    }

    function isScore(scores, key) {
      return scores[key] is int && scores[key] >= 1 && scores[key] <= 5;
    }

    // every rating question q4..q25 answered with an integer 1-5
    function isValidScores(scores) {
      return scores is map
        && scores.keys().hasOnly(['q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10', 'q11', 'q12', 'q13', 'q14', 'q15', 'q16', 'q17', 'q18', 'q19', 'q20', 'q21', 'q22', 'q23', 'q24', 'q25'])
        && scores.keys().hasAll(['q4', 'q5', 'q6', 'q7', 'q8', 'q9', 'q10', 'q11', 'q12', 'q13', 'q14', 'q15', 'q16', 'q17', 'q18', 'q19', 'q20', 'q21', 'q22', 'q23', 'q24', 'q25'])
        && isScore(scores, 'q4')
        && isScore(scores, 'q5')
        && isScore(scores, 'q6')
        && isScore(scores, 'q7')
        && isScore(scores, 'q8')
        && isScore(scores, 'q9')
        && isScore(scores, 'q10')
        && isScore(scores, 'q11')
        && isScore(scores, 'q12')
        && isScore(scores, 'q13')
        && isScore(scores, 'q14')
        && isScore(scores, 'q15')
        && isScore(scores, 'q16')
        && isScore(scores, 'q17')
        && isScore(scores, 'q18')
        && isScore(scores, 'q19')
        && isScore(scores, 'q20')
        && isScore(scores, 'q21')
        && isScore(scores, 'q22')
        && isScore(scores, 'q23')
        && isScore(scores, 'q24')
        && isScore(scores, 'q25');
    }

    match /surveyResponses/{responseId} {
      allow create: if request.resource.data.keys().hasOnly([
          'identity', 'channels', 'device', 'scores', 'issueCount',
          'issueTypes', 'improvement', 'suggestion', 'createdAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.identity in identityOptions()
        && request.resource.data.device in deviceOptions()
        && request.resource.data.issueCount in issueCountOptions()
        && request.resource.data.channels is list
        && request.resource.data.channels.size() >= 1
        && request.resource.data.channels.hasOnly(channelOptions())
        && request.resource.data.issueTypes is list
        && request.resource.data.issueTypes.hasOnly(issueTypeOptions())
        && isValidScores(request.resource.data.scores)
        && isShortString(request.resource.data.improvement, 2000)
        && isShortString(request.resource.data.suggestion, 2000);

      allow read, delete: if isManager();
      allow update: if false;
    }

    // =========================
    // Everything else is denied
    // =========================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
