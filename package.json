{
  "name": "cksc-tickets",
  "version": "0.0.1",
  "description": "A platform for buying CK Party Night tickets.",
  "productName": "CKSC Online Tickets",
  "author": "ChrisSun0731",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "yarn test:client && yarn --cwd functions test",
    "test:client": "node --test tests/checkoutRecovery.test.js tests/notificationProgress.test.js tests/orderSearch.test.js",
    "test:checkout": "node --test tests/checkoutRecovery.test.js",
    "dev": "quasar dev",
    "build": "quasar build",
    "test:rules": "firebase emulators:exec --only firestore --project demo-cksc-ticket \"node --test tests/firestore.rules.test.js\""
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "firebase": "^10.14.1",
    "html2pdf.js": "^0.14.0",
    "pinia": "^2.1.7",
    "qrcode": "^1.5.4",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@quasar/app-vite": "^2.1.4",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.35",
    "sass": "^1.32.12"
  },
  "engines": {
    "node": "^24 || ^22",
    "yarn": ">= 1.21.1"
  }
}
