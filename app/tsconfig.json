{
  "compilerOptions": {
    "target": "es2022",
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "@cloudflare/vitest-plugin/types"
    ],
    "allowJs": true,
    "checkJs": false
  },
  "include": [
    "src",
    "test"
  ],
  "exclude": [
    "test/**/vitest.config.ts"
  ]
}